# ============================================================================
# MAHALAKSHMI HOSPITAL MANAGEMENT SYSTEM — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and replace all placeholders with strong secrets
# before running in production. NEVER commit .env to version control.
# ============================================================================

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Credentials (Required)
POSTGRES_DB=mahalakshmi_hms
DB_USERNAME=CHANGE_ME_DB_ADMIN_USER
DB_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD_MIN_24_CHARS
DB_URL=jdbc:postgresql://postgres:5432/mahalakshmi_hms

# JWT Signing Secret (Required - Minimum 64 characters / 512-bit entropy)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64_CHARS_MINIMUM
JWT_EXPIRATION_MS=28800000

# Secure Medical Document Storage Path
REPORTS_STORAGE_DIR=/app/secure-storage/reports

# Domain & HTTPS Configuration
HOSPITAL_DOMAIN=hms.mahalakshmihospital-eluru.in
CORS_ALLOWED_ORIGINS=https://hms.mahalakshmihospital-eluru.in
